# sol-db configuration
# Connection string for the database you are auditing.
# IMPORTANT: use a dedicated least-privilege role (SELECT on system catalogs only).
# Never reuse your application's admin credentials. Never commit this file.
AUDIT_DB_URL=postgres://readonly_user:password@host/dbname?sslmode=require

# Optional: override the target label used in reports/history (defaults to CLI --target or db host)
# SOL_DB_DEFAULT_TARGET=my-database

# Optional: comma-separated regex patterns for tables considered sensitive by the missing-rls rule
# SENSITIVE_TABLE_PATTERNS=user,email,payment,token,password,secret,credential,session,api_key

# Optional: comma-separated column-name patterns treated as potential secrets
# SECRET_COLUMN_PATTERNS=password,passwd,secret,api_key,apikey,token,credential,private_key
